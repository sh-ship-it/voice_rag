# ==============================================================================
# Voice-Enabled RAG System Environment Configuration Template
# ==============================================================================

# API Keys
SARVAM_API_KEY=your_sarvam_api_key_here
HF_TOKEN=your_huggingface_token_here

# Pipeline Models & Settings
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
SARVAM_LANGUAGE_CODE=hi-IN

# Storage Paths
DATA_DIR=./data
INDEX_DIR=./index

# Response Policy
ANSWER_MODE=extractive
ENABLE_RERANK=true

# Retrieval Settings
TOP_K_DENSE=50
TOP_K_SPARSE=50
TOP_K_FINAL=5
RRF_K=60

# FastAPI Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8000