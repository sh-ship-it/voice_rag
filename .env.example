# ==============================================================================
# Voice-Enabled RAG System Environment Configuration
# ==============================================================================

# API Keys
SARVAM_API_KEY=sk_akme0kin_TC8AyxD0FpNoNIag0AYVo6Ns
CEREBRAS_API_KEY=your_cerebras_api_key_here
HF_TOKEN=your_huggingface_token_here

# Pipeline Models & Settings
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
CEREBRAS_MODEL=llama-3.3-70b
SARVAM_LANGUAGE_CODE=hi-IN

# Storage Paths
DATA_DIR=./data
INDEX_DIR=./index

# Dataset (ai4bharat/MSMARCO-XI)
# Note: datasets>=3.x consolidates all languages under config='default'.
# Use DATASET_LANG to filter to the desired language's rows.
DATASET_NAME=ai4bharat/MSMARCO-XI
DATASET_CONFIG=default
DATASET_LANG=hin_Deva
DATASET_ROWS=3000

# Retrieval Settings
TOP_K_DENSE=10
TOP_K_SPARSE=10
TOP_K_FINAL=5
RRF_K=60

# FastAPI Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Generation Layer — Groq Fast Inference
# Set GENERATION_PROVIDER=groq and supply GROQ_API_KEY to activate Groq path.
# On timeout, malformed JSON, empty answer, or invalid citations, the pipeline
# automatically falls back to extractive snippets from the already-retrieved chunks.
# No re-search, no re-embedding, no additional LLM call is performed on fallback.
GENERATION_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_MS=350
EXTRACTIVE_FALLBACK_ENABLED=true

